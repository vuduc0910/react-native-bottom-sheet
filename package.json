{
  "name": "@vuduc0801/react-native-bottom-sheet",
  "description": "Build bottom sheet for react native",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/esm/index.js",
        "types": "./dist/index.d.mts"
      },
      "require": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "biome:check": "biome check --write",
    "build": "tsup",
    "build:watch": "tsup --watch ./src"
  },
  "keywords": [
    "react-native",
    "bottom-sheet",
    "ui"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "tsup": "^8.2.4"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^4.6.4",
    "@types/react": "^18.3.18",
    "react-native": "^0.75.2",
    "react-native-safe-area-context": "4.10.1",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuduc0910/react-native-bottom-sheet.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/vuduc0910/react-native-bottom-sheet/issues"
  },
  "homepage": "https://github.com/vuduc0910/react-native-bottom-sheet#readme"
}